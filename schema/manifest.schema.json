{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/marcocastignoli/gamelator-db/schema/manifest.schema.json",
  "title": "Gamelator game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "name", "version", "detection", "container"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Manifest schema this game needs; apps hide games above their supported version."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable id; must equal the directory name under games/."
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump to re-trigger provisioning on installed devices."
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFiles", "exeName"],
      "properties": {
        "requiredFiles": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Files/dirs (relative to the game folder) that must exist for the folder to validate."
        },
        "exeName": { "type": "string" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenSize", "graphicsDriver", "dxwrapper", "startupSelection", "box64Preset"],
      "properties": {
        "screenSize": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "graphicsDriver": {
          "type": "string",
          "description": "\"auto\" picks Turnip on Adreno and Vortek elsewhere; or a concrete Winlator driver id."
        },
        "dxwrapper": { "type": "string" },
        "dxwrapperConfig": {
          "type": "string",
          "description": "e.g. \"version=1.10.3\" to pin DXVK for old d3d9 games instead of the per-launch probe."
        },
        "startupSelection": { "type": "integer", "minimum": 0, "maximum": 2 },
        "box64Preset": { "type": "string" },
        "envVars": { "type": "string", "description": "Appended to the container defaults." }
      }
    },
    "controlsProfile": {
      "type": "string",
      "description": "Winlator touch-controls profile (.icp) file in this game's directory."
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "description": "App-side downloads, verified against the pinned sha256 before any script can touch them."
    },
    "patchScript": {
      "type": "string",
      "description": "Sandboxed provisioning script (see the app's sandbox API); omit for pure-declarative games."
    },
    "accountsDir": {
      "type": "string",
      "description": "Directory (relative to the game folder) whose subdirectories are per-user accounts; enables the script's accounts.forEach helper."
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "label"],
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "enum": ["choice", "choice+custom", "text", "toggle"] },
          "label": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string", "description": "script:<fn> that supplies choices." },
          "apply": { "type": "string", "description": "script:<fn> or config:<key> that applies the value." }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "userSteps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waitForDir": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
